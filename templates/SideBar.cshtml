@using BlogGenerator.Models
@using RazorLight
@inherits TemplatePage<SideBarModel>
@{
    var model = Model;
    var latestPosts = model.Articles.Take(6).ToArray();
    var tags = model.Articles.SelectMany(x => x.Tags).Distinct().ToArray()
        .Select(tag => new
        {
            Tag = tag,
            Count = model.Articles.Count(x => x.Tags.Contains(tag))
        })
        .OrderByDescending(x => x.Count)
        .Take(10)
        .ToArray();
    var archives = model.Articles
        .GroupBy(x => new { x.Published.Year, x.Published.Month })
        .Select(group => new
        {
            group.Key.Year,
            group.Key.Month,
            Count = group.Count()
        })
        .OrderByDescending(x => x.Year)
        .ThenByDescending(x => x.Month)
        .ToArray();
}

<aside class="sidebar" aria-label="サイドバー">
    <section class="sidebar-section profile-card">
        <img class="profile-image" src="@Model.GeneratePath("/img/icon.png")" width="96" height="96" loading="lazy" alt="@Model.SiteOption.SiteAuthor">
        <div>
            <p class="profile-name">@Model.SiteOption.SiteAuthor</p>
            <p class="profile-description">@Model.SiteOption.SiteAuthorDescription</p>
            <nav class="profile-links" aria-label="プロフィールリンク">
                <a href="@Model.GeneratePath("about")">About</a>
                <a href="https://x.com/hitsuji_no_hito" rel="me">X</a>
                <a href="https://github.com/Ovis" rel="me">GitHub</a>
            </nav>
        </div>
    </section>

    <section class="sidebar-section">
        <h2 class="sidebar-heading">最近の記事</h2>
        <ol class="recent-list">
            @foreach (var post in latestPosts)
            {
                <li>
                    <a href="@Model.GeneratePath(post.RootRelativePath)">@post.Title</a>
                    <time datetime="@post.Published.ToString("o")">@post.Published.ToString("yyyy.MM.dd")</time>
                </li>
            }
        </ol>
    </section>

    <section class="sidebar-section">
        <h2 class="sidebar-heading">タグ</h2>
        <ul class="sidebar-tags">
            @foreach (var tag in tags)
            {
                <li><a href="@Model.GeneratePath($"/tags/{tag.Tag}")">@tag.Tag <span>@tag.Count</span></a></li>
            }
        </ul>
    </section>

    <section class="sidebar-section archive-section">
        <h2 class="sidebar-heading">アーカイブ</h2>
        <ul class="archive-list">
            @foreach (var archive in archives)
            {
                <li>
                    <a href="@Model.GeneratePath($"/{archive.Year}/{archive.Month:D2}")">
                        <span>@archive.Year.@archive.Month.ToString("D2")</span>
                        <span>@archive.Count</span>
                    </a>
                </li>
            }
        </ul>
    </section>

    <section class="sidebar-section sidebar-ad" aria-label="広告">
        <p class="sidebar-heading">広告</p>
        <div class="ad-slot">
            <iframe src="https://rcm-fe.amazon-adsystem.com/e/cm?o=9&p=12&l=ur1&category=amazonrotate&f=ifr&linkID=65ba289d868057473de193a9c5f6dfb2&t=ovis91-22&tracking_id=ovis91-22"
                    width="300" height="250" loading="lazy" scrolling="no" title="Amazon 広告"></iframe>
        </div>
        <div class="ad-slot ad-slot-responsive">
            <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js"></script>
            <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-3466091512464589" data-ad-slot="3364962157" data-ad-format="auto" data-full-width-responsive="true"></ins>
            <script>
                (adsbygoogle = window.adsbygoogle || []).push({});
            </script>
        </div>
    </section>
</aside>
