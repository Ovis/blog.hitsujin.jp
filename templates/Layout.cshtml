@using BlogGenerator.Enums
@using BlogGenerator.Models
@using RazorLight
@inherits TemplatePage<PageModel>
@{
    var model = Model;
    var isArticle = model.PageType == PageType.Article;
    var isSearchPage = isArticle && string.Equals(model.ContentTemplate, "Search.cshtml", StringComparison.OrdinalIgnoreCase);
    var pageTitle = isArticle
        ? $"{model.Articles.First().Title} | {model.SiteOption.SiteName}"
        : model.SiteOption.SiteName;
    var ogType = isArticle ? "article" : "website";
    var ogUrl = isArticle
        ? model.GeneratePath(model.Articles.First().RootRelativePath)
        : model.SiteOption.SiteUrl;
    var ogDescription = isArticle
        ? model.Articles.First().Description
        : model.SiteOption.SiteDescription;
}

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@pageTitle</title>
    <meta name="description" content="@ogDescription">
    <meta name="application-name" content="@Model.SiteOption.SiteName">
    <meta name="theme-color" content="#f7f4ee">
    <meta property="og:title" content="@pageTitle">
    <meta property="og:site_name" content="@Model.SiteOption.SiteName">
    <meta property="og:type" content="@ogType">
    <meta property="og:description" content="@ogDescription">
    <meta property="og:url" content="@ogUrl">
    <link type="application/rss+xml" rel="alternate" href="@Model.GeneratePath("feed.rss")">
    <link type="application/atom+xml" rel="alternate" href="@Model.GeneratePath("feed.atom")">
    <link rel="shortcut icon" href="@Model.GeneratePath("favicon.ico")" type="image/x-icon">
    <link rel="icon" href="@Model.GeneratePath("favicon.ico")" type="image/x-icon">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/prismjs@1.30.0/themes/prism-tomorrow.min.css">
    <link rel="stylesheet" href="@Model.GeneratePath("css/blog.css")">
    <link rel="stylesheet" href="@Model.GeneratePath("css/search.css")">
    @if (isSearchPage)
    {
        <link rel="stylesheet" href="@Model.GeneratePath("pagefind/pagefind-ui.css")">
        <script src="@Model.GeneratePath("pagefind/pagefind-ui.js")"></script>
    }
    <meta name="google-adsense-account" content="ca-pub-3466091512464589">
</head>
<body>
    <header class="site-header">
        <div class="site-header-inner">
            <div class="site-identity">
                <a class="site-brand" href="@Model.GeneratePath("/")">@Model.SiteOption.SiteName</a>
                <p class="site-description">@Model.SiteOption.SiteDescription</p>
            </div>
            <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false">
                <span class="nav-toggle-label">Menu</span>
                <span class="nav-toggle-lines" aria-hidden="true"><span></span><span></span></span>
            </button>
            <nav class="site-nav" id="site-nav" aria-label="メインナビゲーション">
                <a href="@Model.GeneratePath("/")">Home</a>
                <a href="@Model.GeneratePath("about")">About</a>
                <a href="@Model.GeneratePath("tags")">Tags</a>
                <a href="@Model.GeneratePath("search.html")">Search</a>
            </nav>
        </div>
    </header>

    <div class="page-shell">
        <main class="main-column">
            @switch (model.PageType)
            {
                case PageType.Article:
                    await IncludeAsync(model.ContentTemplate ?? "Content.cshtml", model);
                    break;
                case PageType.PageList:
                    await IncludeAsync("PageList.cshtml", model);
                    break;
                case PageType.Tag:
                    await IncludeAsync("Tag.cshtml", model);
                    break;
            }
        </main>
        <div class="sidebar-column">
            @Raw(Model.SideBarHtml.Value)
        </div>
    </div>

    <footer class="site-footer">
        <div class="site-footer-inner">
            <p>© @DateTime.Now.Year @Model.SiteOption.SiteName</p>
            <div class="footer-feeds">
                <a href="@Model.GeneratePath("feed.rss")">RSS</a>
                <a href="@Model.GeneratePath("feed.atom")">Atom</a>
            </div>
        </div>
    </footer>

    <script defer src="https://cdn.jsdelivr.net/npm/prismjs@1.30.0/components/prism-core.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/prismjs@1.30.0/plugins/autoloader/prism-autoloader.min.js" data-autoloader-path="https://cdn.jsdelivr.net/npm/prismjs@1.30.0/components/"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/medium-zoom@1.1.0/dist/medium-zoom.min.js"></script>
    <script defer src="@Model.GeneratePath("js/blog.js")"></script>
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-21HJPJ2VN8"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-21HJPJ2VN8');
    </script>
</body>
</html>
