@using BlogGenerator.Models
@using RazorLight
@inherits TemplatePage<PageModel>

<section class="post-index" aria-label="記事一覧">
    @foreach (var article in Model.Articles)
    {
        <article class="post-preview">
            <header>
                <time class="post-date" datetime="@article.Published.ToString("o")">@article.Published.ToString("yyyy年M月d日")</time>
                <h2><a href="@Model.GeneratePath(article.RootRelativePath)">@article.Title</a></h2>
                @if (article.Tags.Count > 0)
                {
                    <ul class="tag-list" aria-label="タグ">
                        @foreach (var tag in article.Tags)
                        {
                            <li><a href="@Model.GeneratePath($"/tags/{tag}")">@tag</a></li>
                        }
                    </ul>
                }
            </header>
            <div class="post-excerpt article-body">
                @Raw(article.ExcerptHtmlContent.Value)
            </div>
            @if (!string.IsNullOrEmpty(article.RemainingHtml))
            {
                <a class="read-more" href="@Model.GeneratePath(article.RootRelativePath)">
                    続きを読む <span aria-hidden="true">→</span>
                </a>
            }
        </article>
    }
</section>

@{
    await IncludeAsync("_pagination.cshtml", Model);
}
