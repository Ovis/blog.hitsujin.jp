@model BlogGenerator.MarkdigExtension.OgpCardModel
<a class="ogp-card" href="@Model.Url" target="_blank" rel="nofollow noopener noreferrer" aria-label="@Model.Title">
    <span class="ogp-card-content">
        <span class="ogp-card-site">
            <img class="ogp-card-favicon" src="@Model.FaviconUrl" alt="" width="18" height="18" loading="lazy" />
            <span class="ogp-card-site-name">@Model.SiteName</span>
        </span>
        <span class="ogp-card-title">@Model.Title</span>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <span class="ogp-card-description">@Model.Description</span>
        }
        <span class="ogp-card-url">@Model.DisplayUrl</span>
    </span>
    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        <span class="ogp-card-image-wrapper" aria-hidden="true">
            <img class="ogp-card-image" src="@Model.ImageUrl" alt="" loading="lazy" />
        </span>
    }
</a>
