@using System.IO
@using BlogGenerator.Models
@using RazorLight
@inherits TemplatePage<PageModel>
@{
    var currentPage = Model.Pagination.CurrentPage;
    var totalPages = Model.Pagination.TotalPages;
    var maxPagesToShow = Model.Pagination.MaxPagesToShow;
    var path = Model.Pagination.RelativeDirectoryPath;
}

@if (totalPages > 1)
{
    <nav class="pagination" aria-label="ページ送り">
        <a class="pagination-direction @(currentPage == 1 ? "is-disabled" : "")"
           href="@((currentPage - 1) == 1 ? path : Path.Combine(path, $"{currentPage - 1}"))"
           aria-disabled="@(currentPage == 1 ? "true" : "false")">
            <span aria-hidden="true">←</span> 新しい記事
        </a>

        <ol class="pagination-list">
            @if (totalPages <= maxPagesToShow)
            {
                for (var i = 1; i <= totalPages; i++)
                {
                    <li><a class="pagination-link @(i == currentPage ? "is-current" : "")" href="@(i == 1 ? path : Path.Combine(path, $"{i}"))" aria-current="@(i == currentPage ? "page" : null)">@i</a></li>
                }
            }
            else
            {
                <li><a class="pagination-link @(currentPage == 1 ? "is-current" : "")" href="@path" aria-current="@(currentPage == 1 ? "page" : null)">1</a></li>
                if (currentPage > 3)
                {
                    <li><span class="pagination-ellipsis">…</span></li>
                }

                var startPage = Math.Max(2, currentPage - 1);
                var endPage = Math.Min(totalPages - 1, currentPage + 1);
                for (var i = startPage; i <= endPage; i++)
                {
                    <li><a class="pagination-link @(i == currentPage ? "is-current" : "")" href="@Path.Combine(path, $"{i}")" aria-current="@(i == currentPage ? "page" : null)">@i</a></li>
                }

                if (currentPage < totalPages - 2)
                {
                    <li><span class="pagination-ellipsis">…</span></li>
                }
                <li><a class="pagination-link @(currentPage == totalPages ? "is-current" : "")" href="@Path.Combine(path, $"{totalPages}")" aria-current="@(currentPage == totalPages ? "page" : null)">@totalPages</a></li>
            }
        </ol>

        <a class="pagination-direction @(currentPage == totalPages ? "is-disabled" : "")"
           href="@Path.Combine(path, $"{currentPage + 1}")"
           aria-disabled="@(currentPage == totalPages ? "true" : "false")">
            古い記事 <span aria-hidden="true">→</span>
        </a>
    </nav>
}
