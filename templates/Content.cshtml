@using BlogGenerator.Models
@using RazorLight
@inherits TemplatePage<PageModel>
@{
    var article = Model.Articles.First();
}

<article class="article-page">
    @if (!article.IsFixedPage)
    {
        <header class="article-header">
            <p class="article-kicker">Article</p>
            <h1>@article.Title</h1>
            <div class="article-meta">
                <time datetime="@article.Published.ToString("o")">@article.Published.ToString("yyyy年M月d日")</time>
                @if (article.Tags.Count > 0)
                {
                    <span class="meta-separator" aria-hidden="true">•</span>
                    <ul class="tag-list" aria-label="タグ">
                        @foreach (var tag in article.Tags)
                        {
                            <li><a href="@Model.GeneratePath($"/tags/{tag}")">@tag</a></li>
                        }
                    </ul>
                }
            </div>
        </header>
    }
    <div class="article-body">
        @Raw(article.BodyHtml.Value)
    </div>
</article>
