@using BlogGenerator.Models
@using RazorLight
@inherits TemplatePage<PageModel>
@{
    var article = Model.Articles.First();
}

<article class="article-page">
    @if (!article.IsFixedPage)
    {
        <header class="article-header">
            <p class="article-kicker">Article</p>
            <h1 data-pagefind-body data-pagefind-meta="title" data-pagefind-weight="10">@article.Title</h1>
            <div class="article-meta">
                <time datetime="@article.Published!.Value.ToString("o")" data-pagefind-meta="date:@article.Published.Value.ToString("yyyy年M月d日")">@article.Published.Value.ToString("yyyy年M月d日")</time>
                @if (Model.GetArticleTags(article).Count > 0)
                {
                    <span class="meta-separator" aria-hidden="true">•</span>
                    <ul class="tag-list" aria-label="タグ">
                        @foreach (var tag in Model.GetArticleTags(article))
                        {
                            <li><a href="@Model.GenerateTagPath(tag.DisplayName)">@tag.DisplayName</a></li>
                        }
                    </ul>
                }
            </div>
        </header>
        <div class="article-body" data-pagefind-body>
            @Raw(article.BodyHtml.Value)
        </div>
    }
    else
    {
        <div class="article-body">
            @Raw(article.BodyHtml.Value)
        </div>
    }
</article>
