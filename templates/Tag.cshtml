@using BlogGenerator.Models
@using RazorLight
@inherits TemplatePage<PageModel>
@{
    var tags = Model.Articles.SelectMany(x => x.Tags).Distinct().ToArray()
        .Select(tag => new
        {
            Tag = tag,
            Count = Model.Articles.Count(x => x.Tags.Contains(tag))
        })
        .OrderByDescending(x => x.Count)
        .ThenBy(x => x.Tag)
        .ToArray();
}

<section class="tag-index">
    <header class="section-header">
        <p class="article-kicker">Topics</p>
        <h1>タグから記事を探す</h1>
    </header>
    <ul class="tag-cloud">
        @foreach (var tag in tags)
        {
            <li>
                <a href="@Model.GeneratePath($"/tags/{tag.Tag}")">
                    <span>@tag.Tag</span><small>@tag.Count</small>
                </a>
            </li>
        }
    </ul>
</section>
