@using BlogGenerator.Models
@using RazorLight
@inherits TemplatePage<PageModel>
@{
    var tags = Model.TagCatalog.Entries
        .OrderByDescending(x => x.Count)
        .ThenBy(x => x.DisplayName)
        .ToArray();
}

<section class="tag-index">
    <header class="section-header">
        <p class="article-kicker">Topics</p>
        <h1>タグから記事を探す</h1>
    </header>
    <ul class="tag-cloud">
        @foreach (var tag in tags)
        {
            <li>
                <a href="@Model.GenerateTagPath(tag.DisplayName)">
                    <span>@tag.DisplayName</span><small>@tag.Count</small>
                </a>
            </li>
        }
    </ul>
</section>
